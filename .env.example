# ---------------------------------------------------------------------------
# Good Square — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Session signing secret for wallet-auth cookies. Use a random string of at
# least 32 characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# Celo network selection.
#   42220     = Celo mainnet
#   11142220  = Celo Sepolia (testnet)
NEXT_PUBLIC_CELO_CHAIN_ID=11142220
NEXT_PUBLIC_CELO_RPC_URL=https://forno.celo.org
NEXT_PUBLIC_CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
