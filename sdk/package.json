{
  "name": "@goodsquare/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Good Square API",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["goodsquare", "celo", "community", "sdk", "web3"],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
